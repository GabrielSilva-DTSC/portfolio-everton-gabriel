---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaFigure from '../../components/MediaFigure.astro';
import MediaGallery from '../../components/MediaGallery.astro';
import { projects } from '../../data/portfolio';
import { localPath } from '../../utils/paths';
export function getStaticPaths() {
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const next = projects[(projects.findIndex(p => p.slug === project.slug) + 1) % projects.length];
---
<BaseLayout title={`${project.title} — Everton Gabriel`} description={project.summary}>
  <article class={`case-study theme-${project.theme}`}>
    <header class="case-hero wrap">
      <a class="text-link case-back" href={`${localPath()}#projetos`}><span aria-hidden="true">←</span> Todos os projetos</a>
      <p class="eyebrow">{project.category}</p>
      <h1>{project.title}</h1>
      <p class="case-subtitle">{project.subtitle}</p>
      {project.links && <div class="case-links">{project.links.map(link => <a class="text-link" href={link.url}>{link.label}<span aria-hidden="true">↗</span></a>)}</div>}
      <dl class:list={['case-meta', { 'has-period': project.period }]}><div><dt>Papel</dt><dd>{project.role}</dd></div><div><dt>Contexto</dt><dd>{project.context}</dd></div>{project.period && <div><dt>Período</dt><dd><time datetime={project.period}>{project.period}</time></dd></div>}<div><dt>Apresentação</dt><dd>{project.presentation ?? 'Relato inicial do projeto'}</dd></div></dl>
      {project.gallery?.length && <div class="case-gallery">
        <MediaFigure id={project.gallery[0]} sizes="(max-width: 1050px) 89vw, 1000px" />
        {project.gallery.length > 1 && <MediaGallery ids={project.gallery.slice(1)} label="Ver outras telas do projeto" collapsible />}
      </div>}
    </header>
    <div class="case-body"><p class="case-summary">{project.summary}</p>{project.sections.map((section, i) => <section class="case-section"><span class="eyebrow">0{i + 1}</span><div><h2>{section.title}</h2><p>{section.text}</p></div></section>)}
      <aside class="case-evidence"><p class="eyebrow">Sobre os registros</p><p>{project.evidenceNote ?? 'Esta é uma apresentação inicial, baseada no relato da minha trajetória. Documentos, imagens e links serão incorporados após a revisão dos materiais, com autoria e contexto.'}</p></aside>
    </div>
  </article>
  <div class="next-project wrap"><span class="eyebrow">Continue explorando</span><a href={localPath(`projetos/${next.slug}/`)}>{next.title}<span aria-hidden="true">↗</span></a></div>
</BaseLayout>
